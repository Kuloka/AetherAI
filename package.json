{
  "name": "multimind",
  "version": "1.21.0",
  "description": "MultiMind - local AI workspace with collaborative agents",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "check": "node scripts/check-syntax.cjs",
    "fix:encoding": "node scripts/fix-mojibake.js --write",
    "dist:win": "electron-builder --win nsis portable",
    "test": "node --test tests/*.test.js",
    "dist:mac": "electron-builder --mac dmg",
    "dist:linux": "electron-builder --linux AppImage deb"
  },
  "productName": "MultiMind",
  "private": true,
  "build": {
    "appId": "ai.multimind.place",
    "productName": "MultiMind",
    "files": [
      "**/*",
      "!dist/**",
      "!.git/**",
      "!tests/**",
      "!resources/nevo-*",
      "!artifacts/**",
      "!docs/**",
      "!.github/**",
      "!resources/branding/**",
      "!scripts/**",
      "scripts/sd_turbo_generate.py"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "icon": "resources/multimind-logo.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "MultiMind",
      "guid": "b74d891e-393a-5bfb-895d-fb3070229109"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "resources/multimind-logo-mac.png",
      "target": [
        "dmg"
      ],
      "artifactName": "MultiMind-macOS-${version}-${arch}.${ext}"
    },
    "linux": {
      "category": "Utility",
      "icon": "resources/multimind-logo.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "MultiMind-Linux-${version}-${arch}.${ext}",
      "maintainer": "MultiMind"
    },
    "asarUnpack": [
      "node_modules/@img/**/*",
      "node_modules/sharp/**/*"
    ]
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "sharp": "^0.34.3",
    "zod": "^4.5.4"
  },
  "author": {
    "name": "MultiMind"
  }
}
